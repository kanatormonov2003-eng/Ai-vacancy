# PostgreSQL container settings
POSTGRES_DB=leadhunter
POSTGRES_USER=leadhunter
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# LeadHunter app/test connection string
DATABASE_URL=postgresql://leadhunter:replace-with-a-local-development-password@127.0.0.1:5432/leadhunter
TEST_DATABASE_URL=postgresql://leadhunter:replace-with-a-local-development-password@127.0.0.1:5432/leadhunter

# Required by production configuration, not consumed by PostgreSQL itself
APP_ENV=test
SECRET_KEY=replace-with-at-least-32-random-characters
